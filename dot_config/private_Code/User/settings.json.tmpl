{{- $theme := "One Dark Pro" -}}
{{- if eq .theme "catppuccin" -}}
{{-   $theme = get (dict "latte" "Catppuccin Latte" "frappe" "Catppuccin Frappé" "macchiato" "Catppuccin Macchiato" "mocha" "Catppuccin Mocha") .theme_suffix -}}
{{- else if eq .theme "dracula" -}}
{{-   $theme = "Dracula Theme" -}}
{{- else if eq .theme "nord" -}}
{{-   $theme = "Nord" -}}
{{- else if eq .theme "onedark" -}}
{{-   $theme = "One Dark Pro" -}}
{{- end -}}
{
  "cmake.generator": "Ninja",
  "dart.devToolsBrowser": "default",
  "dev.containers.dockerComposePath": "podman-compose",
  "dev.containers.dockerPath": "podman",
  "dotfiles.repository": "lightspeedbriefs/dotnext",
  "editor.fontFamily": "'Monaspace Neon NF','Cascadia Code PL','JetBrains Mono','Font Awesome 7 Brands'",
  "editor.fontLigatures": "'calt', 'ss01', 'ss02', 'ss03', 'ss06', 'ss09', 'liga'",
  "editor.semanticTokenColorCustomizations": {
    "[Catppuccin Frappé]": {
      "rules": {
        "property": "#babbf1"
      }
    },
    "[Catppuccin Latte]": {
      "rules": {
        "property": "#7287fd"
      }
    },
    "[Catppuccin Macchiato]": {
      "rules": {
        "property": "#b7bdf8"
      }
    },
    "[Catppuccin Mocha]": {
      "rules": {
        "property": "#b4befe"
      }
    },
    "[One Dark Pro]": {
      "rules": {
        "parameter": "#D19A66",
        "property": "#9D527C",
        "property:python": "#9D527C",
        "variable.readonly:python": "#D19A66"
      }
    }
  },
  "editor.stickyScroll.defaultModel": "foldingProviderModel",
  "editor.stickyScroll.enabled": true,
  "editor.suggest.preview": true,
  "errorLens.codeLensEnabled": true,
  "errorLens.enabledDiagnosticLevels": [
    "error",
    "warning",
    "info",
    "hint"
  ],
  "errorLens.gutterIconsEnabled": true,
  "files.associations": {
    "*.bst": "yaml",
    ".clang-tidy": "yaml"
  },
  "files.autoSave": "afterDelay",
  "files.trimTrailingWhitespace": true,
  "git.autofetch": true,
  "git.detectWorktrees": true,
  "git.mergeEditor": true,
  "gitlens.blame.ignoreWhitespace": true,
  "gitlens.telemetry.enabled": false,
  "redhat.telemetry.enabled": false,
  "security.promptForLocalFileProtocolHandling": false,
  "telemetry.telemetryLevel": "off",
  "terminal.integrated.allowChords": false,
  "terminal.integrated.confirmOnExit": "hasChildProcesses",
  "terminal.integrated.confirmOnKill": "always",
  "terminal.integrated.fontLigatures.enabled": true,
  "terminal.integrated.fontLigatures.featureSettings": "'calt' on, 'liga' on, 'ss01' on, 'ss02' on, 'ss03' on, 'ss06' on, 'ss09' on",
  "terminal.integrated.persistentSessionScrollback": 1000,
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.shellIntegration.enabled": true,
  "textmarker.enableTelemetry": false,
  "vim.easymotion": true,
  "vim.handleKeys": {
    "<C-p>": false,
    "<C-d>": true,
    "<C-s>": false,
    "<C-z>": false
  },
  "vim.highlightedyank.enable": true,
  "vim.sneak": true,
  "window.commandCenter": true,
  "window.menuBarVisibility": "compact",
  "window.titleBarStyle": "custom",
  "workbench.colorTheme": "{{ $theme }}",
{{- if eq .theme "catppuccin" }}
  "workbench.iconTheme": "catppuccin-{{ .theme_suffix }}",
{{- end }}
  "workbench.preferredDarkColorTheme": "{{ $theme }}"
}
